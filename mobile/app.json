{
  "expo": {
    "name": "Level",
    "slug": "level-trades",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "level",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E6E9E4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.level.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Level uses the camera so you can take photos of the job for tradies to see.",
        "NSPhotoLibraryUsageDescription": "Level needs access to your photos so you can add pictures of the job for tradies to see.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nz.level.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4FD1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Level needs access to your photos so you can add pictures of the job for tradies to see.",
          "cameraPermission": "Level uses the camera so you can take photos of the job for tradies to see.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F4FD1",
          "defaultChannel": "default"
        }
      ]
    ],
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#1F4FD1"
    },
    "extra": {
      "apiUrl": "https://level-wcyc.onrender.com",
      "eas": {
        "projectId": ""
      }
    }
  }
}
